{
  "$id": "task_toml_1_4",
  "title": "Harbor task.toml schema_version 1.4 (strict)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "version": { "type": "string", "description": "legacy alias for schema_version" },
    "source": { "type": "string" },
    "multi_step_reward_strategy": { "enum": ["mean", "final"] },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*/[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "authors": { "type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["name"],
          "properties": { "name": { "type": "string" }, "email": { "type": "string" } }
        } },
        "keywords": { "type": "array", "items": { "type": "string" } }
      }
    },
    "metadata": { "type": "object", "description": "free-form dict[str,Any]" },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_sec": { "type": "number", "minimum": 0 },
        "user": { "type": ["string", "integer"] },
        "network_mode": { "enum": ["no-network", "public", "allowlist"] },
        "allowed_hosts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_sec": { "type": "number", "minimum": 0 },
        "user": { "type": ["string", "integer"] },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "environment_mode": { "enum": ["shared", "separate"] },
        "network_mode": { "enum": ["no-network", "public", "allowlist"] },
        "allowed_hosts": { "type": "array", "items": { "type": "string" } },
        "environment": { "$ref": "#/definitions/environment" },
        "collect": { "type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["command"],
          "properties": {
            "command": { "type": "string" },
            "service": { "type": "string" },
            "timeout_sec": { "type": "number", "minimum": 0 },
            "user": { "type": ["string", "integer"] }
          }
        } }
      }
    },
    "environment": { "$ref": "#/definitions/environment" },
    "solution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "env": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string" },
          { "type": "object", "additionalProperties": false, "required": ["source"],
            "properties": {
              "source": { "type": "string" },
              "destination": { "type": "string" },
              "exclude": { "type": "array", "items": { "type": "string" } },
              "service": { "type": "string" }
            } }
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "agent": { "type": "object" },
          "verifier": { "type": "object" },
          "min_reward": { "anyOf": [{ "type": "number" }, { "type": "object" }] },
          "healthcheck": { "type": "object" },
          "artifacts": { "type": "array" }
        }
      }
    }
  },
  "definitions": {
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build_timeout_sec": { "type": "number", "minimum": 0 },
        "docker_image": { "type": "string" },
        "os": { "enum": ["linux", "windows"] },
        "cpus": { "type": "integer", "minimum": 1 },
        "memory_mb": { "type": "integer", "minimum": 1 },
        "storage_mb": { "type": "integer", "minimum": 1 },
        "gpus": { "type": "integer", "minimum": 0 },
        "gpu_types": { "type": "array", "items": { "type": "string" } },
        "tpu": { "type": "object", "additionalProperties": false, "required": ["type", "topology"],
          "properties": { "type": { "type": "string" }, "topology": { "type": "string" } } },
        "mcp_servers": { "type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "transport": { "enum": ["stdio", "sse", "streamable-http", "http"] },
            "url": { "type": "string" },
            "command": { "type": "string" },
            "args": { "type": "array", "items": { "type": "string" } }
          }
        } },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "skills_dir": { "type": "string" },
        "workdir": { "type": "string" },
        "allow_internet": { "type": "boolean" },
        "network_mode": { "enum": ["no-network", "public", "allowlist"] },
        "allowed_hosts": { "type": "array", "items": { "type": "string" } },
        "healthcheck": { "type": "object", "additionalProperties": false, "required": ["command"],
          "properties": {
            "command": { "type": "string" },
            "interval_sec": { "type": "number", "minimum": 0 },
            "timeout_sec": { "type": "number", "minimum": 0 },
            "start_period_sec": { "type": "number", "minimum": 0 },
            "start_interval_sec": { "type": "number", "minimum": 0 },
            "retries": { "type": "integer", "minimum": 0 }
          } }
      }
    }
  }
}
